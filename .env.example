# Пример конфигурации окружения для METALINE Website
# Скопируйте этот файл в .env и заполните значениями

# Режим приложения
NODE_ENV=development

# Порт dev-сервера
PORT=5173

# API endpoints (если используются)
# VITE_API_URL=https://api.metaline.ru
# VITE_API_KEY=your-api-key-here

# Аналитика
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_YM_ID=XXXXXXXX

# Контакты (для формы обратной связи)
# VITE_CONTACT_EMAIL=info@metaline.ru
# VITE_CONTACT_PHONE=+74951234567

# Карта (если используется)
# VITE_MAPS_API_KEY=your-maps-api-key

# Социальные сети
# VITE_VK_URL=https://vk.com/metaline
# VITE_TELEGRAM_URL=https://t.me/metaline
# VITE_INSTAGRAM_URL=https://instagram.com/metaline
